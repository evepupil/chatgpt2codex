    "test": "vitest run",
    "gate": "pnpm format && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
