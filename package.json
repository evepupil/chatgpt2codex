{
  "name": "gpt-web-codex",
  "version": "0.1.0",
  "private": true,
  "description": "An extensible local Agent Runtime for GPT Web coding workflows.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --check .",
